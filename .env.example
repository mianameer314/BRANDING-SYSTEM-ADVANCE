# ============================
# Application Config
# ============================
APP_NAME="O2geeks Headless CMS"
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# ============================
# Database Configuration
# ============================
DATABASE_URL=postgresql://user:password@localhost:5432/branding_cms
REDIS_URL=redis://localhost:6379

# ============================
# JWT Authentication
# ============================
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRY_MINUTES=30
JWT_REFRESH_EXPIRY_DAYS=7

# ============================
# Default Admin User
# ============================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_in_production

# ============================
# CORS & Previews
# ============================
CORS_ORIGINS=*
VITE_FRONTEND_URL=http://localhost:3000

# ============================
# Storage
# ============================
STORAGE_PROVIDER=local
MEDIA_URL=/media
LOCAL_STORAGE_PATH=storage

# ============================
# AWS S3 (only when STORAGE_PROVIDER=s3)
# ============================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
AWS_ENDPOINT_URL=

# ============================
# Upload Limits
# ============================
MAX_IMAGE_SIZE_MB=5
MAX_FILE_SIZE_MB=20
IMAGE_MAX_WIDTH=1920
ALLOWED_IMAGE_TYPES=.jpg,.jpeg,.png,.webp,.gif

# ============================
# Rate Limits (requests/seconds)
# ============================
RATE_LIMIT_LOGIN=5/60
RATE_LIMIT_REGISTER=3/60
RATE_LIMIT_REFRESH=20/60
RATE_LIMIT_PUBLIC_GET=120/60
RATE_LIMIT_AUTH_GET=300/60
RATE_LIMIT_CREATE=20/60
RATE_LIMIT_UPDATE=30/60
RATE_LIMIT_DELETE=10/60
RATE_LIMIT_UPLOAD=10/60
RATE_LIMIT_COMMENT=30/60
RATE_LIMIT_LIKE=60/60
RATE_LIMIT_USER_MGT=10/60

# ============================
# AI Content Generation (OpenRouter)
# ============================
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-3-27b-it
RATE_LIMIT_AI_GENERATE=20/3600


# ============================
# Webhook Configuration
# ============================
WEBHOOK_ENABLED=true
WEBHOOK_SIGNING_ENABLED=true
WEBHOOK_TIMEOUT=10.0
WEBHOOK_USER_AGENT="O2Geeks Headless CMS Dispatcher"