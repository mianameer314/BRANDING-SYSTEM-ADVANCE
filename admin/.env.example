# O2Geeks CMS Admin Dashboard — Environment Variables
# Copy this file to .env and fill in the values. Never commit .env

# Required: Backend API base URL — no trailing slash
VITE_API_BASE_URL=

# Required: localStorage key names for JWT tokens (customize as needed)
VITE_TOKEN_STORAGE_KEY=
VITE_REFRESH_TOKEN_STORAGE_KEY=
 
VITE_FRONTEND_URL=http://localhost:3000
